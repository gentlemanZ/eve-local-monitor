[General]
# Your EVE character name (will be excluded from analysis)
character_name = YourCharacterName

[OCR]
# Screen region to capture Local player list (left, top, right, bottom)
# Example for right side of 1920x1080 screen: 1500, 200, 1900, 800
# Leave blank to configure interactively on first run
region_left =
region_top =
region_right =
region_bottom =

[Monitoring]
# How often to scan Local (in seconds)
scan_interval = 10

# Cache expiry for player data (in seconds)
cache_expiry = 3600

[Standing]
# Filter out players with friendly standings (blue, green, purple icons)
# Set to false to see all players regardless of standing
filter_friendly = true

# Comma-separated list of colors to consider friendly and filter out
# Available colors: blue, green, purple, white, orange, yellow, red
friendly_colors = blue,green,purple
